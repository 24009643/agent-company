# 复制为 .env 并按需修改(注意:当前程序读系统环境变量;最稳的改法是直接改 config.py 默认值)

# Ollama 与模型
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3

# 双模型(切换模式):两个都需先 ollama pull
LLM_MODEL=qwen2.5:7b
LLM_MODEL_2=deepseek-r1:7b
DEFAULT_MODEL_ID=qwen

# 检索
TOP_K=4
MIN_SCORE=0.35
DATA_DIR=./data

# 版本与授权(商业化)
# EDITION: basic(基础版) / pro(专业版,含多部门隔离) / enterprise(企业版,含数据分析)
EDITION=enterprise
LICENSE_SEATS=50
LICENSE_EXPIRES=2099-12-31
LICENSED_TO=演示企业
